# ============================================================
# AI Groundwater Information Assistant — .gitignore
# ============================================================

# --- Secrets & API Keys (NEVER commit) ---
.env
.env.*
!.env.example
*.key
*.pem
secrets.toml

# --- Python cache & bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.conda/

# --- Generated / cached model files (regenerated automatically on first run) ---
Data/groundwater_embeddings.pt
Data/searchable_corpus.csv

# --- Generated summary CSVs (regenerated by read_data.py) ---
district_groundwater_summary.csv
yearly_groundwater_summary.csv

# --- Generated images (produced by visualize_data.py) ---
*.png
*.jpg
*.jpeg

# --- Streamlit cache ---
.streamlit/
__streamlit_session__/

# --- IDE / editor files ---
.vscode/
.idea/
*.swp
*.swo
*.DS_Store
Thumbs.db
desktop.ini

# --- OS files ---
.DS_Store
ehthumbs.db

# --- Jupyter notebooks checkpoints ---
.ipynb_checkpoints/

# --- Build / distribution ---
dist/
build/
*.egg-info/
*.egg

# --- Logs ---
*.log
